# Used by the `caddy` container in docker-compose.yml (mounted at /etc/caddy/Caddyfile).
# DOMAIN + LETSENCRYPT_EMAIL come from .env — no need to edit this file.
# Caddy fetches/renews the HTTPS certificate automatically.

{
	email {$LETSENCRYPT_EMAIL}
}

{$DOMAIN}, www.{$DOMAIN} {
	encode gzip
	reverse_proxy app:8080
}
