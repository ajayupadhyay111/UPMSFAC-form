# Copy this file to ".env" and fill in strong values. Never commit the real .env.

# SQL Server 'sa' password — must be strong (>=8 chars, upper+lower+digit+symbol).
DB_PASSWORD=Change_This_Str0ng#Pass

# JWT signing key — long random string (>=32 chars). Generate e.g.:  openssl rand -base64 48
JWT_KEY=Change_This_To_A_Long_Random_Secret_At_Least_32_Chars
